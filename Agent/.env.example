# ===== Server =====
AGENT_HOST=0.0.0.0
AGENT_PORT=18080
APP_ENV=dev

# ===== SiliconFlow (OpenAI-compatible) =====
SILICONFLOW_API_KEY=YOUR_SILICONFLOW_API_KEY
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_CHAT_MODEL=deepseek-ai/DeepSeek-V3
SILICONFLOW_EMBED_MODEL=BAAI/bge-m3

# ===== LangGraph Checkpoint =====
CHECKPOINT_SQLITE_PATH=./data/checkpoints.sqlite

# ===== Qdrant =====
QDRANT_URL=http://127.0.0.1:6333
QDRANT_API_KEY=YOUR_QDRANT_API_KEY
QDRANT_COLLECTION=ticket_agent_knowledge

# ===== Langfuse Cloud =====
LANGFUSE_PUBLIC_KEY=YOUR_LANGFUSE_PUBLIC_KEY
LANGFUSE_SECRET_KEY=YOUR_LANGFUSE_SECRET_KEY
LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_ENABLED=true

# ===== Java microservices (Agent tools) =====
JAVA_INTERNAL_BASE_URL=http://127.0.0.1:7071
JAVA_INTERNAL_TOKEN=YOUR_JAVA_INTERNAL_TOKEN
JAVA_TOOLS_ENABLED=true
JAVA_HTTP_TIMEOUT=12
JAVA_ORDER_BASE_URL=http://127.0.0.1:8087
JAVA_PRICE_BASE_URL=http://127.0.0.1:8084
JAVA_DRIVER_BASE_URL=http://127.0.0.1:8086
JAVA_TICKET_BASE_URL=http://127.0.0.1:8091
JAVA_MAP_BASE_URL=http://127.0.0.1:8085
ASSIST_MAX_TOOL_STEPS=5
